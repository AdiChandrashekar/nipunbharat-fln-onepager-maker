{
  "name": "one-pager-maker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:pages": "tsc -p tsconfig.json && vite build --mode pages",
    "preview:pages": "vite preview --mode pages --outDir docs --port 5179",
    "typecheck": "tsc -p tsconfig.json",
    "images": "python scripts/tg_images.py",
    "test:editor": "node scripts/editor-test.mjs test-output/editor",
    "test:export": "node scripts/export-test.mjs test-output/export && python scripts/verify_exports.py test-output/export",
    "sync-data": "python scripts/sync_data.py"
  },
  "dependencies": {
    "@fontsource/anek-devanagari": "^5.3.0",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/khand": "^5.3.0",
    "@fontsource/mukta": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@fontsource/tiro-devanagari-hindi": "^5.3.0",
    "fflate": "^0.8.3",
    "modern-screenshot": "^4.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-moveable": "^0.56.0",
    "react-selecto": "^1.26.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
